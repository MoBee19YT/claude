# Copy this file to .env and fill in what you have.
# Nothing here is required to run the app with OpenStreetMap data only.

# --- Database ---
# Used by both the FastAPI app and the OSM import script (async driver).
DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:5432/parking

# --- Region the app is scoped to on first run (used by the import script) ---
# Bounding box: min_lon,min_lat,max_lon,max_lat. Default = Prague, Czech Republic.
DEFAULT_BBOX=14.2246,49.9420,14.7071,50.1774
DEFAULT_CITY=Prague
DEFAULT_COUNTRY=Czech Republic

# --- Overpass (OpenStreetMap) ---
# Public instance, no key required. Override if you self-host or hit rate limits.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Live fallback: if a requested map area has no cached data yet, fetch it from
# Overpass on the fly and cache it. Real data, fetched lazily instead of
# requiring the import script to be run first. Set to false to disable.
OSM_LIVE_FALLBACK=true

# --- Nominatim (OpenStreetMap search / geocoding) ---
# Public instance, no key required, but keep request volume low (usage policy:
# https://operations.osmfoundation.org/policies/nominatim/). Set a contact
# email so OSM can reach you if something misbehaves.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT_EMAIL=you@example.com

# --- Optional providers ---
# TomTom Search & Availability API. Get a free-tier key at
# https://developer.tomtom.com/. Leave blank to disable this provider -
# the app runs fine without it and will say so in /api/v1/meta/providers.
TOMTOM_API_KEY=

# HERE Destination Services (Parking Availability). Get a free-tier key at
# https://developer.here.com/. Leave blank to disable this provider.
HERE_API_KEY=

# --- Admin endpoints ---
# Set this to any long random string to enable /api/v1/admin/import and
# /api/v1/admin/status, which let you populate the database from a browser
# on hosts where you can't run the import script (e.g. Render's free tier).
# Left blank, those endpoints refuse every request.
ADMIN_TOKEN=

# --- CORS ---
# Comma-separated list of origins allowed to call this API. In production
# (e.g. a GitHub Pages frontend) set this to that origin, such as
# https://your-username.github.io - see README.md "Deploying to production".
CORS_ORIGINS=http://localhost:5173
