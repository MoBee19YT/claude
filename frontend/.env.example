# Copy to .env and adjust if your backend runs somewhere other than localhost.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Center/zoom the map starts at. Defaults to Prague; change for a
# different initial city - this is just the starting viewport, not a
# hardcoded data boundary.
VITE_DEFAULT_LAT=50.0755
VITE_DEFAULT_LON=14.4378
VITE_DEFAULT_ZOOM=14
